{
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "version": "1.0.0",
    "manifest_version": 3,
    "icons": {
        "128": "icon.png"
    },
        "permissions": [
        "clipboardRead"
    ],
    "content_scripts": [
        {
            "matches": ["https://gemini.google.com/*", "http://gemini.google.com/*"],
            "js": [
                "turndown.js",
                "utils.js",
                "actions/checkactions.js",
                "actions/copyactions.js",
                "buttoncreator.js",
                "content.js"
            ],
            "css": [
                "css/style.css"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_title": "__MSG_extensionName__"
    }
}
