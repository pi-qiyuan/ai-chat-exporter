{
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "version": "2.0.0",
    "manifest_version": 3,
    "icons": {
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*",
                "http://gemini.google.com/*",
                "https://chatgpt.com/*",
                "https://claude.ai/*"
            ],
            "js": [
                "turndown.js",
                "utils.js",
                "storagemanager.js",
                "actions/checkactions.js",
                "actions/copyactions.js",
                "providers/gemini.js",
                "providers/chatgpt.js",
                "providers/claude.js",
                "buttoncreator.js",
                "content.js"
            ],
            "css": [
                "css/style.css"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_title": "__MSG_extensionName__"
    },
    "permissions": [
        "storage"
    ]
}
